---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import ContactPanel from '../components/ContactPanel.astro';
import ServiceCards from '../components/ServiceCards.astro';
import { services, business, copy } from '../data/site';
type PageKind = 'service' | 'gallery' | 'contact' | 'privacy';
type Service = (typeof services)[number];
export function getStaticPaths(){return [...services.map(service=>({params:{slug:service.itSlug},props:{kind:'service',service}})),{params:{slug:'gallery'},props:{kind:'gallery'}},{params:{slug:'contatti'},props:{kind:'contact'}},{params:{slug:'protezione-dei-dati'},props:{kind:'privacy'}}];}
const {kind,service}=Astro.props as {kind:PageKind;service?:Service};
const serviceData = service as Service;
const slug=Astro.params.slug!;
const deAlt=kind==='service'?`/de/${serviceData.deSlug}/`:kind==='gallery'?'/de/galerie/':kind==='contact'?'/de/kontakt/':'/de/datenschutz/';
const title=kind==='service'?`${serviceData.it.title} | Hydrotech Service Sagl`:kind==='gallery'?'Gallery lavori Hydrotech | Hydrotech Service Sagl':kind==='contact'?'Contatti e informazioni | Hydrotech Service Sagl':'Protezione dei dati | Hydrotech Service Sagl';
const description=kind==='service'?serviceData.it.description:kind==='gallery'?'Gallery dei lavori e degli ambiti Hydrotech Service Sagl: impianti sanitari, riscaldamento, irrigazione, bagni e ricerca perdite in Ticino.':kind==='contact'?'Contatta Hydrotech Service Sagl per informazioni, un sopralluogo o una richiesta in Ticino.':'Informazioni sulla protezione dei dati per il sito Hydrotech Service Sagl.';
const c = copy.it;
---
<BaseLayout lang="it" title={title} description={description} canonicalPath={`/${slug}/`} alternatePath={deAlt}>
{kind==='service'&&<Fragment><section class="page-hero"><div class="container"><p class="breadcrumb"><a href="/">Home</a> / {serviceData.it.name}</p><h1>{serviceData.it.title}</h1><p>{serviceData.it.description}</p><div class="hero-actions"><a class="button" href="#preventivo">{c.quote}</a><a class="button secondary" href={business.phoneHref}>Chiama {business.phone}</a></div></div></section><section class="section"><div class="container detail-grid"><picture class="detail-media"><source srcset={`/assets/images/${serviceData.image}.avif`} type="image/avif"/><source srcset={`/assets/images/${serviceData.image}.webp`} type="image/webp"/><img src={`/assets/images/${serviceData.image}.jpg`} alt={serviceData.it.name} width="900" height="675" loading="lazy"/></picture><div class="detail-copy"><h2>{serviceData.it.detailTitle}</h2><p>{serviceData.it.detail}</p><ul class="check-list">{serviceData.it.checks.map(x=><li>{x}</li>)}</ul><div class="proof-row">{serviceData.it.proofs.map(x=><span>{x}</span>)}</div></div></div></section><section class="section soft"><div class="container"><div class="section-head"><h2>Altri ambiti Hydrotech</h2><p>Se il problema coinvolge più impianti, lo valutiamo in modo coordinato.</p></div><ServiceCards lang="it" exclude={serviceData.id}/></div></section><section class="section"><div class="container quote-section"><QuoteForm lang="it" source={`service-${serviceData.itSlug}`}/><ContactPanel lang="it"/></div></section></Fragment>}
{kind==='gallery'&&<Fragment><section class="page-hero"><div class="container"><p class="breadcrumb"><a href="/">Home</a> / Gallery</p><h1>Gallery lavori Hydrotech</h1><p>{description}</p><div class="hero-actions"><a class="button" href="/contatti/">Richiedi informazioni</a><a class="button secondary" href={business.phoneHref}>Chiama {business.phone}</a></div></div></section><section class="section"><div class="container"><div class="gallery-grid">{services.map(s=><article class="gallery-item"><picture><source srcset={`/assets/images/${s.image}.avif`} type="image/avif"/><source srcset={`/assets/images/${s.image}.webp`} type="image/webp"/><img src={`/assets/images/${s.image}.jpg`} alt={s.it.name} width="900" height="675" loading="lazy"/></picture><div><h2>{s.it.name}</h2><p>{s.it.description}</p></div></article>)}</div></div></section></Fragment>}
{kind==='contact'&&<Fragment><section class="page-hero"><div class="container"><p class="breadcrumb"><a href="/">Home</a> / Contatti</p><h1>Contatti e informazioni</h1><p>{description}</p></div></section><section class="section soft"><div class="container quote-section"><QuoteForm lang="it" source="contact-it"/><ContactPanel lang="it"/></div></section></Fragment>}
{kind==='privacy'&&<Fragment><section class="page-hero"><div class="container"><p class="breadcrumb"><a href="/">Home</a> / Privacy</p><h1>Protezione dei dati</h1><p>{description}</p></div></section><section class="section"><div class="container privacy-content"><h2>Titolare del trattamento</h2><p>Hydrotech Service Sagl, Via Vecchio Forno 2, CH-6604 Solduno, email <a href="mailto:info@hydrotechservice.ch">info@hydrotechservice.ch</a>.</p><h2>Dati raccolti</h2><p>Il modulo di contatto raccoglie i dati inseriti volontariamente: nome, telefono, email, servizio richiesto e messaggio. I dati sono usati solo per rispondere alla richiesta.</p><h2>Base e durata del trattamento</h2><p>I dati vengono trattati per gestire la richiesta di informazioni, preventivo o contatto e conservati solo per il tempo necessario alla relazione commerciale e agli obblighi di legge applicabili.</p><h2>Cookie e statistiche</h2><p>Il sito è progettato per funzionare senza tracciamenti non necessari.</p><h2>Diritti</h2><p>Per domande, rettifiche o cancellazione dei dati è possibile scrivere a <a href="mailto:info@hydrotechservice.ch">info@hydrotechservice.ch</a>.</p></div></section></Fragment>}
</BaseLayout>
