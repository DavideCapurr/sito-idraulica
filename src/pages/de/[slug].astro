---
import BaseLayout from '../../layouts/BaseLayout.astro';
import QuoteForm from '../../components/QuoteForm.astro';
import ContactPanel from '../../components/ContactPanel.astro';
import ServiceCards from '../../components/ServiceCards.astro';
import { services, business } from '../../data/site';
export function getStaticPaths(){return [...services.map(service=>({params:{slug:service.deSlug},props:{kind:'service',service}})),{params:{slug:'galerie'},props:{kind:'gallery'}},{params:{slug:'kontakt'},props:{kind:'contact'}},{params:{slug:'datenschutz'},props:{kind:'privacy'}}];}
const {kind,service}=Astro.props; const slug=Astro.params.slug!;
const itAlt=kind==='service'?`/${service.itSlug}/`:kind==='gallery'?'/gallery/':kind==='contact'?'/contatti/':'/protezione-dei-dati/';
const title=kind==='service'?`${service.de.title} | Hydrotech Service Sagl`:kind==='gallery'?'Galerie Hydrotech | Hydrotech Service Sagl':kind==='contact'?'Kontakt und kostenlose Offerte | Hydrotech Service Sagl':'Datenschutz | Hydrotech Service Sagl';
const description=kind==='service'?service.de.description:kind==='gallery'?'Galerie der Arbeiten und Bereiche von Hydrotech Service Sagl im Tessin.':kind==='contact'?'Kontaktieren Sie Hydrotech Service Sagl für eine Besichtigung oder kostenlose Offerte im Tessin.':'Informationen zum Datenschutz auf der Website von Hydrotech Service Sagl.';
---
<BaseLayout lang="de" title={title} description={description} canonicalPath={`/de/${slug}/`} alternatePath={itAlt}>
{kind==='service'&&<Fragment><section class="page-hero"><div class="container"><p class="breadcrumb"><a href="/de/">Home</a> / {service.de.name}</p><h1>{service.de.title}</h1><p>{service.de.description}</p><div class="hero-actions"><a class="button" href="#preventivo">Offerte anfragen</a><a class="button secondary" href={business.phoneHref}>Anrufen {business.phone}</a></div></div></section><section class="section"><div class="container detail-grid"><picture class="detail-media"><source srcset={`/assets/images/${service.image}.avif`} type="image/avif"/><source srcset={`/assets/images/${service.image}.webp`} type="image/webp"/><img src={`/assets/images/${service.image}.jpg`} alt={service.de.name} width="900" height="675" loading="lazy"/></picture><div class="detail-copy"><h2>{service.de.detailTitle}</h2><p>{service.de.detail}</p><ul class="check-list">{service.de.checks.map(x=><li>{x}</li>)}</ul><div class="proof-row">{service.de.proofs.map(x=><span>{x}</span>)}</div></div></div></section><section class="section soft"><div class="container"><div class="section-head"><h2>Weitere Hydrotech Bereiche</h2><p>Wenn mehrere Anlagen betroffen sind, beurteilen wir sie koordiniert.</p></div><ServiceCards lang="de" exclude={service.id}/></div></section><section class="section"><div class="container quote-section"><QuoteForm lang="de" source={`service-${service.deSlug}`}/><ContactPanel lang="de"/></div></section></Fragment>}
{kind==='gallery'&&<Fragment><section class="page-hero"><div class="container"><p class="breadcrumb"><a href="/de/">Home</a> / Galerie</p><h1>Galerie Hydrotech</h1><p>{description}</p><div class="hero-actions"><a class="button" href="/de/kontakt/">Informationen anfragen</a><a class="button secondary" href={business.phoneHref}>Anrufen {business.phone}</a></div></div></section><section class="section"><div class="container"><div class="gallery-grid">{services.map(s=><article class="gallery-item"><picture><source srcset={`/assets/images/${s.image}.avif`} type="image/avif"/><source srcset={`/assets/images/${s.image}.webp`} type="image/webp"/><img src={`/assets/images/${s.image}.jpg`} alt={s.de.name} width="900" height="675" loading="lazy"/></picture><div><h2>{s.de.name}</h2><p>{s.de.description}</p></div></article>)}</div></div></section></Fragment>}
{kind==='contact'&&<Fragment><section class="page-hero"><div class="container"><p class="breadcrumb"><a href="/de/">Home</a> / Kontakt</p><h1>Kontakt und kostenlose Offerte</h1><p>{description}</p></div></section><section class="section soft"><div class="container quote-section"><QuoteForm lang="de" source="contact-de"/><ContactPanel lang="de"/></div></section></Fragment>}
{kind==='privacy'&&<Fragment><section class="page-hero"><div class="container"><p class="breadcrumb"><a href="/de/">Home</a> / Datenschutz</p><h1>Datenschutz</h1><p>{description}</p></div></section><section class="section"><div class="container privacy-content"><h2>Verantwortliche Stelle</h2><p>Hydrotech Service Sagl, Via Vecchio Forno 2, CH-6604 Solduno, E-Mail <a href="mailto:info@hydrotechservice.ch">info@hydrotechservice.ch</a>.</p><h2>Erhobene Daten</h2><p>Das Kontaktformular erfasst freiwillig eingegebene Angaben wie Name, Telefon, E-Mail, gewünschte Leistung und Nachricht.</p><h2>Zweck und Aufbewahrung</h2><p>Die Daten werden zur Bearbeitung von Kontakt- und Offertanfragen verarbeitet und nur so lange aufbewahrt, wie es erforderlich ist.</p><h2>Cookies und Statistik</h2><p>Die Website ist so aufgebaut, dass sie ohne unnötiges Tracking funktioniert.</p><h2>Rechte</h2><p>Für Auskunft, Berichtigung oder Löschung können Sie an <a href="mailto:info@hydrotechservice.ch">info@hydrotechservice.ch</a> schreiben.</p></div></section></Fragment>}
</BaseLayout>
