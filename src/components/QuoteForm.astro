---
import { business, services, copy, type Lang } from '../data/site';
interface Props { lang:Lang; source:string; }
const { lang, source } = Astro.props; const de = lang === 'de'; const c = copy[lang];
---
<div class="quote-panel" id="preventivo"><h2>{c.quoteTitle}</h2><form action="/api/quote" method="post"><input type="hidden" name="language" value={lang}/><input type="hidden" name="source" value={source}/><div class="honeypot"><label>Website<input type="text" name="website" tabindex="-1" autocomplete="off"/></label></div><div class="form-grid"><div class="field"><label>{de?'Name':'Nome'}<input name="name" type="text" autocomplete="name" required/></label></div><div class="field"><label>{de?'Telefon':'Telefono'}<input name="phone" type="tel" autocomplete="tel" required/></label></div><div class="field"><label>{de?'E-Mail':'Email'}<input name="email" type="email" autocomplete="email"/></label></div><div class="field"><label>{de?'Leistung':'Servizio'}<select name="service" required><option value="">{de?'Leistung auswählen':'Seleziona un servizio'}</option>{services.map(s=><option value={s[lang].name}>{s[lang].name}</option>)}</select></label></div><div class="field full"><label>{de?'Nachricht':'Messaggio'}<textarea name="message" placeholder={de?'Beschreiben Sie kurz Ihre Anfrage...':'Scrivi qui la tua richiesta...'} required></textarea></label></div></div><p class="form-note">{de?'Mit dem Absenden erlauben Sie die Verarbeitung der Daten zur Beantwortung Ihrer Anfrage.':'Inviando il modulo accetti il trattamento dei dati per rispondere alla richiesta.'} <a href={de?'/de/datenschutz/':'/protezione-dei-dati/'}>{de?'Datenschutz':'Privacy'}</a></p><p class="form-note"><a href={business.phoneHref}>{business.phone}</a> · <a href={`mailto:${business.email}`}>{business.email}</a></p><button class="button" type="submit">{de?'Anfrage senden':'Invia richiesta'}</button><p class="form-note">{de?'Wir melden uns so schnell wie möglich. Sie können uns auch direkt anrufen.':'Rispondiamo il prima possibile. Puoi anche chiamarci direttamente.'}</p></form></div>
