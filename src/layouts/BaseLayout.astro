---
import '../styles/global.css';
import { business, services, copy, type Lang } from '../data/site';
interface Props { lang:Lang; title:string; description:string; canonicalPath:string; alternatePath:string; }
const { lang, title, description, canonicalPath, alternatePath } = Astro.props;
const c = copy[lang];
const prefix = lang === 'de' ? '/de' : '';
const canonical = `${business.canonical}${canonicalPath}`;
const alternateLang = lang === 'it' ? 'de' : 'it';
const weekdays = ['Monday','Tuesday','Wednesday','Thursday','Friday'];
const schema = {
  '@context':'https://schema.org',
  '@type':'Plumber',
  '@id':`${business.canonical}/#business`,
  name:business.name,
  url:business.canonical,
  logo:`${business.canonical}/assets/brand/logo-hydrotech.svg`,
  image:`${business.canonical}/assets/images/hero-installation.webp`,
  email:business.email,
  telephone:business.phone,
  address:{
    '@type':'PostalAddress',
    streetAddress:business.officeStreet,
    postalCode:'6604',
    addressLocality:'Solduno',
    addressRegion:'Ticino',
    addressCountry:'CH'
  },
  openingHoursSpecification:[
    {'@type':'OpeningHoursSpecification',dayOfWeek:weekdays,opens:'08:00',closes:'12:00'},
    {'@type':'OpeningHoursSpecification',dayOfWeek:weekdays,opens:'13:30',closes:'17:00'}
  ],
  areaServed:['Ticino','Locarno','Bellinzona','Lugano','Ascona','Solduno'].map(name=>({'@type':'Place',name}))
};
---
<!doctype html><html lang={lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang={lang} href={canonical}/><link rel="alternate" hreflang={alternateLang} href={`${business.canonical}${alternatePath}`}/><link rel="alternate" hreflang="x-default" href={`${business.canonical}/`}/><link rel="icon" href="/favicon.ico" sizes="any"/><meta property="og:type" content="website"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={business.name}/><meta property="og:image" content={`${business.canonical}/assets/images/hero-installation.webp`}/><meta name="twitter:card" content="summary_large_image"/><script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}/></head><body>
<header class="site-header"><a class="skip-link" href="#contenuto">{lang==='it'?'Salta al contenuto':'Zum Inhalt'}</a><div class="container header-inner"><a class="brand" href={`${prefix}/`} aria-label={`${business.name} home`}><img src="/assets/brand/logo-hydrotech.svg" alt={business.name} width="420" height="120" loading="eager" decoding="async"/></a><nav class="nav"><a href={`${prefix}/#servizi`}>{c.services}</a><a href={lang==='it'?'/gallery/':'/de/galerie/'}>{c.gallery}</a><a href={lang==='it'?'/contatti/':'/de/kontakt/'}>{c.contacts}</a><span class="lang-switch"><a href={lang==='it'?canonicalPath:alternatePath} aria-current={lang==='it'?'true':undefined}>IT</a><span>/</span><a href={lang==='de'?canonicalPath:alternatePath} aria-current={lang==='de'?'true':undefined}>DE</a></span><a class="button" href={business.phoneHref}>{c.call}</a></nav><label class="mobile-menu-button" for="mobile-nav-toggle" aria-label="Menu">☰</label></div><input class="mobile-nav-toggle" id="mobile-nav-toggle" type="checkbox"/><nav class="mobile-nav"><div class="container"><a href={`${prefix}/#servizi`}>{c.services}</a>{services.map(s=><a href={lang==='it'?`/${s.itSlug}/`:`/de/${s.deSlug}/`}>{s[lang].name}</a>)}<a href={lang==='it'?'/gallery/':'/de/galerie/'}>{c.gallery}</a><a href={lang==='it'?'/contatti/':'/de/kontakt/'}>{c.contacts}</a><a href={alternatePath}>{lang==='it'?'DE':'IT'}</a><a href={business.phoneHref}>{c.call}</a></div></nav></header><main id="contenuto"><slot/></main>
<footer class="site-footer"><div class="container"><div class="footer-grid"><div><img class="footer-logo" src="/assets/brand/logo-hydrotech.svg" alt={business.name} width="360" height="103" loading="lazy"/><p>{business.legalAddress}</p></div><div><h2>{c.services}</h2><ul><li><a href={lang==='it'?'/gallery/':'/de/galerie/'}>{c.gallery}</a></li>{services.map(s=><li><a href={lang==='it'?`/${s.itSlug}/`:`/de/${s.deSlug}/`}>{s[lang].name}</a></li>)}</ul></div><div><h2>{c.contacts}</h2><ul><li><a href={business.phoneHref}>{business.phone}</a></li><li><a href={business.urgentPhoneHref}>{business.urgentPhone}</a></li><li><a href={`mailto:${business.email}`}>{business.email}</a></li><li><a href={lang==='it'?'/contatti/':'/de/kontakt/'}>{c.contacts}</a></li></ul></div><div><h2>{lang==='it'?'Orari d’apertura ufficio':'Öffnungszeiten Büro'}</h2><p>{lang==='it'?'Lunedì-Venerdì':'Montag-Freitag'}<br/>8:00 – 12:00 / 13:30 – 17:00</p><p>{lang==='it'?'Sabato su appuntamento':'Samstag nach Vereinbarung'}</p></div></div><div class="footer-bottom"><span>© 2026 {business.name} – {lang==='it'?'Tutti i diritti riservati.':'Alle Rechte vorbehalten.'}</span><a href={lang==='it'?'/protezione-dei-dati/':'/de/datenschutz/'}>{lang==='it'?'Protezione dei dati':'Datenschutz'}</a><a href={alternatePath}>{lang==='it'?'Deutsch':'Italiano'}</a></div></div></footer><div class="mobile-cta"><a href={business.phoneHref}>{lang==='it'?'Chiama':'Anrufen'}</a><a href={lang==='it'?'/gallery/':'/de/galerie/'}>{c.gallery}</a></div></body></html>
